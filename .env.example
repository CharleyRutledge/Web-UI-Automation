# Copy this file to .env (same folder) and fill in your values, for runs on your own computer.
# .env is git-ignored: it never leaves your computer. GitHub runs use the repository secrets instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
# Only if email notifications are turned on in your settings file:
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Logins for the site audit's roles (names match the ${...} in your settings file's auth: section).
# Meridian Data (config/meridian-data.yaml) uses the same names as its own E2E tests. Use test accounts only.
E2E_DEPOSITOR_EMAIL=
E2E_DEPOSITOR_PASSWORD=
E2E_BENEFICIARY_EMAIL=
E2E_BENEFICIARY_PASSWORD=
